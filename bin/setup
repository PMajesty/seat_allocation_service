#!/usr/bin/env ruby
require "fileutils"
require "net/http"
require "uri"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def elasticsearch_up?
  url = URI.parse(ENV.fetch("ELASTICSEARCH_URL", "http://localhost:9200"))
  req = Net::HTTP::Get.new(url)
  res = Net::HTTP.start(url.host, url.port, open_timeout: 1, read_timeout: 1) { |http| http.request(req) }
  res.code == "200"
rescue Errno::ECONNREFUSED, Errno::ECONNRESET, EOFError, Net::ReadTimeout, Net::OpenTimeout
  false
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Checking Infrastructure =="
  unless system("docker compose ps --services --filter 'status=running' | grep -q elasticsearch")
    puts "Starting Docker services..."
    system!("docker compose up -d")
  end

  puts "Waiting for Elasticsearch to be ready..."
  max_retries = 200
  retries = 0
  until elasticsearch_up?
    if retries >= max_retries
      puts "\nERROR: Elasticsearch failed to start after #{max_retries} seconds."
      puts "Check logs with: docker compose logs elasticsearch"
      exit 1
    end
    print "."
    sleep 1
    retries += 1
  end
  puts "\nElasticsearch is ready."

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
