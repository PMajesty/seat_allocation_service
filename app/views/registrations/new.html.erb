<div class="auth-container">
  <h2 class="auth-title">Create Account</h2>

  <%= form_with model: @user, url: signup_path, local: true, id: "signup-form" do |form| %>
    <div id="error-container" class="error-container"></div>

    <div class="form-group">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, placeholder: "name@example.com", class: "form-input", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, class: "form-input", required: true, minlength: 8 %>
      <small class="password-hint">Minimum 8 characters</small>
    </div>

    <div class="form-group">
      <%= form.label :password_confirmation, "Confirm Password", class: "form-label" %>
      <%= form.password_field :password_confirmation, class: "form-input", required: true, minlength: 8 %>
    </div>

    <%= form.submit "Sign Up", class: "btn-submit" %>
  <% end %>
</div>

<script src="/javascripts/auth.js"></script>
