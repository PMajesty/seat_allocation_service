<div class="auth-container">
  <h2 class="auth-title">Sign In</h2>

  <%= form_with url: login_path, local: true, id: "login-form" do |form| %>
    <div id="error-container" class="error-container"></div>

    <div class="form-group">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, placeholder: "name@example.com", class: "form-input", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, class: "form-input", required: true %>
    </div>

    <%= form.submit "Log In", class: "btn-submit" %>
  <% end %>
</div>

<script src="/javascripts/auth.js"></script>
